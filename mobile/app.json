{
  "expo": {
    "name": "Doggy",
    "slug": "doggy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "doggy",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#14726C",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1F7A6C",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Doggy necesita acceder a tus fotos para que elijas la foto de tu mascota. Con esa foto la pueden reconocer si alguna vez se pierde.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Doggy usa tu ubicación para mostrarte las mascotas perdidas cerca tuyo y marcar dónde se perdió la tuya."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Doggy usa la cámara para escanear el QR de la chapita de una mascota que encontraste y avisarle a su familia.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
